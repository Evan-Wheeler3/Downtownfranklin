{
  "name": "downtown-franklin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "First-person life simulator set in a geographically grounded recreation of historic downtown Franklin, Tennessee.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "gauntlet": "node scripts/gauntlet.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "typescript": "~6.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
